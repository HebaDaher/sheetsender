# ===== SheetSender settings =====
# Copy this file to ".env" and fill it in. Never share .env or commit it anywhere.

# --- Required ---
# Public address of the app (must be https:// in production — Google, Microsoft and Meta require it)
BASE_URL=https://sender.yourdomain.com
PORT=3000
# Password to sign in to the dashboard (at least 10 characters — make it strong)
ADMIN_PASSWORD=change-me-to-a-long-password
# Generate the next two with:  npm run gen-secrets
SESSION_SECRET=
# KEEP THIS SAFE AND NEVER CHANGE IT after connecting accounts (it encrypts the stored tokens)
ENCRYPTION_KEY=

# --- Google (Gmail + Google Sheets) — SETUP.md step 4 ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft (Excel on OneDrive) — SETUP.md step 5 (only if you use Excel files) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# --- Meta WhatsApp Cloud API — SETUP.md step 6 ---
# App secret: Meta app → App settings → Basic → App secret (used to verify webhooks)
META_APP_SECRET=
# Any random text; paste the same value in Meta's webhook settings (npm run gen-secrets makes one)
WHATSAPP_VERIFY_TOKEN=
META_API_VERSION=v23.0

# --- Optional tuning ---
# How often each spreadsheet is checked (seconds, minimum 15)
POLL_SECONDS=60
# Gmail free accounts allow about 500 emails/day, Google Workspace about 2,000. Stay below your limit.
GMAIL_DAILY_LIMIT=400
# Files bigger than this (in total, per email) are sent as secure download links instead of attachments
EMAIL_ATTACHMENT_LIMIT_MB=18
MAX_UPLOAD_MB=100
DATA_DIR=data
